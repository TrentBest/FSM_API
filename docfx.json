{
  "metadata": [
    {
      "src": [
        {
          "src": "FSM_API",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "src": ".",
        "files": [
          "index.md"
        ]
      },
      {
        "src": "Documentation",
        "files": [
          "**/*.md",
          "**/*.svg",
          "**/*.png",
          "**/*.jpg",
          "**/*.jpeg",
          "**/*.gif"
        ]
      },
      {
        "src": "api",
        "files": [
          "**/*.yml"
        ]
      }
    ],
    "dest": "_site",
    "sitemap": {
      "baseUrl": "https://trentbest.github.io/FSM_API/",
      "changefreq": "daily",
      "priority": 0.5
    },
    "plugins": [
      "docfx.plugins.mermaid"
    ]
  }
}
